From 6256e1bdf784d1deb72306b915d8b8d8d3fe839d Mon Sep 17 00:00:00 2001
From: Aryamaan Chaurasia <a-chaurasia@ti.com>
Date: Thu, 24 Sep 2026 15:45:04 +0530
Subject: [PATCH 1/2] am64x: Improve OSPI DAC Writes functionality

- Modify OSPI DAC writes to use memcpy() for OSPI PSRAM
- Modify OSPI_lld_setWriteDummyCycles() to use the correct dummy cycle value

Signed-off-by: Aryamaan Chaurasia <a-chaurasia@ti.com>
---
 source/drivers/ospi/v0/lld/ospi_lld.h    |  2 +
 source/drivers/ospi/v0/lld/ospi_v0_lld.c | 54 +++++++++---------------
 2 files changed, 23 insertions(+), 33 deletions(-)

diff --git a/source/drivers/ospi/v0/lld/ospi_lld.h b/source/drivers/ospi/v0/lld/ospi_lld.h
index 04eb082..bde117a 100644
--- a/source/drivers/ospi/v0/lld/ospi_lld.h
+++ b/source/drivers/ospi/v0/lld/ospi_lld.h
@@ -652,6 +652,8 @@ typedef struct
      * */
     uint32_t rdDummyCycles;
     /**< Number of dummy cycles needed for read */
+    uint32_t wrDummyCycles;
+    /**< Number of dummy cycles needed for write */
     uint32_t cmdDummyCycles;
     /**< Number of dummy cycles needed for cmd */
     uint32_t rdDataCapDelay;
diff --git a/source/drivers/ospi/v0/lld/ospi_v0_lld.c b/source/drivers/ospi/v0/lld/ospi_v0_lld.c
index 8e0019c..8000550 100644
--- a/source/drivers/ospi/v0/lld/ospi_v0_lld.c
+++ b/source/drivers/ospi/v0/lld/ospi_v0_lld.c
@@ -837,11 +837,11 @@ void OSPI_lld_setWriteDummyCycles(OSPILLD_Handle hOspi, uint32_t dummyCycles)
     {
         const CSL_ospi_flash_cfgRegs *pReg = (const CSL_ospi_flash_cfgRegs *)(hOspi->baseAddr);
 
-        /* Set read dummy cycles */
+        /* Set write dummy cycles */
         CSL_REG32_FINS(&pReg->DEV_INSTR_WR_CONFIG_REG, OSPI_FLASH_CFG_DEV_INSTR_WR_CONFIG_REG_DUMMY_WR_CLK_CYCLES_FLD, dummyCycles);
 
         /* Update book-keeping variable in OSPI object */
-        hOspi->rdDummyCycles = dummyCycles;
+        hOspi->wrDummyCycles = dummyCycles;
     }
     else
     {
@@ -1615,45 +1615,33 @@ int32_t OSPI_lld_writeCmd(OSPILLD_Handle hOspi, OSPI_WriteCmdParams *wrParams)
 int32_t OSPI_lld_writeDirect(OSPILLD_Handle hOspi, OSPI_Transaction *trans)
 {
     int32_t status = OSPI_SYSTEM_SUCCESS;
-    const CSL_ospi_flash_cfgRegs *pReg = (const CSL_ospi_flash_cfgRegs *)(hOspi->baseAddr);
-
     uint8_t *pSrc;
     uint8_t *pDst;
     uint32_t addrOffset;
+    const CSL_ospi_flash_cfgRegs *pReg;
+    OSPILLD_InitHandle hOspiInit;
 
-    addrOffset = trans->addrOffset;
-    pSrc = (uint8_t *) trans->buf;
-
-    /* Enable Direct Access Mode */
-    CSL_REG32_FINS(&pReg->CONFIG_REG, OSPI_FLASH_CFG_CONFIG_REG_ENB_DIR_ACC_CTLR_FLD, 1);
-    CSL_REG32_WR(&pReg->IND_AHB_ADDR_TRIGGER_REG, 0x04000000);
-
-    pDst = (uint8_t *)(hOspi->hOspiInit->dataBaseAddr + addrOffset);
+    /* Check if hOspi & OSPI_transactions are NULL */
+    if((NULL != hOspi) && (NULL != trans))
+    {
+        pReg = (const CSL_ospi_flash_cfgRegs *)(hOspi->baseAddr);
+        hOspiInit = hOspi->hOspiInit;
+        addrOffset = trans->addrOffset;
+        pSrc = (uint8_t *) trans->buf;
 
-    uint8_t wrByte;
-    uint32_t size, remainingSize;
+        /* Enable Direct Access Mode */
+        CSL_REG32_FINS(&pReg->CONFIG_REG,
+                    OSPI_FLASH_CFG_CONFIG_REG_ENB_DIR_ACC_CTLR_FLD,
+                    1);
+        CSL_REG32_WR(&pReg->IND_AHB_ADDR_TRIGGER_REG, 0x04000000);
 
-    uint32_t *tempSrc = (uint32_t *)pSrc;
-    uint32_t *tempDst = (uint32_t *)pDst;
+        pDst = (uint8_t *)(hOspiInit->dataBaseAddr + addrOffset);
 
-    int i = 0;
+        memcpy(pDst, pSrc, trans->count);
+    }
+    else
     {
-        remainingSize = trans->count & 3U;
-        size = trans->count - remainingSize;
-
-        for(i = 0; i < size; i+=4)
-        {
-            *tempDst = *tempSrc;
-            tempDst++;
-            tempSrc++;
-        }
-
-        //Dangling Bytes
-        for(i = 0; i < remainingSize; i++)
-        {
-            wrByte = CSL_REG8_RD(pSrc + size + i);
-            CSL_REG8_WR(pDst + size + i, wrByte);
-        }
+        status = OSPI_LLD_INVALID_PARAM;
     }
 
     return status;
-- 
2.34.1

