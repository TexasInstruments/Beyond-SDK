# Soft dependencies extracted from modules themselves.
softdep btrfs pre: blake2b-256
softdep btrfs pre: sha256
softdep btrfs pre: xxhash64
softdep btrfs pre: crc32c
softdep xts pre: ecb
softdep libcrc32c pre: crc32c
softdep ipmi_msghandler post: ipmi_devintf
softdep wm8994 pre: wm8994_regulator
softdep r8169 pre: realtek
softdep xt_LOG pre: nf_log_syslog
