<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context
                deviceFamily="ARM"
                deviceId="Cortex R.AM2434_ALV"
            />
        </when>
    </applicability>

    <project
        title="TI BOARD DIAGNOSTIC"
        name = "ti_board_diagnostic_am243x-evm_r5fss0-0_nortos_ti-arm-clang"
        products="sysconfig;com.ti.MCU_PLUS_SDK_AM243X"
        configurations="
                Debug,
                Release,
        "
        connection="TIXDS110_Connection.xml"
        toolChain="TICLANG"
        cgtVersion="4.0.4.LTS"
        device="Cortex R.AM2434_ALV"
        deviceCore="MAIN_PULSAR_Cortex_R5_0_0"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        endianness="little"
        outputFormat="ELF"
        outputType="executable"

        compilerBuildOptions="
            -I${CG_TOOL_ROOT}/include/c
            -I${MCU_PLUS_SDK_PATH}/source
            -mcpu=cortex-r5
            -mfloat-abi=hard
            -mfpu=vfpv3-d16
            -mthumb
            -Wall
            -Werror
            -g
            -Wno-gnu-variable-sized-type-not-at-end
            -Wno-unused-function
            -DSOC_AM243X
            -DOS_NORTOS
        "
        linkerBuildOptions="
            -i${MCU_PLUS_SDK_PATH}/source/kernel/nortos/lib
            -i${MCU_PLUS_SDK_PATH}/source/drivers/lib
            -i${MCU_PLUS_SDK_PATH}/source/board/lib
            -i${CG_TOOL_ROOT}/lib
            -m=ti_board_diagnostic.${ConfigName}.map
            --diag_suppress=10063
            --ram_model
            --reread_libs
            --gen_xml_func_hash
        "

        postBuildStep="$(MAKE) -C ${CCS_PROJECT_DIR} -f makefile_ccs_bootimage_gen OUTNAME=${BuildArtifactFileBaseName} PROFILE=${ConfigName} MCU_PLUS_SDK_PATH=${MCU_PLUS_SDK_PATH} CG_TOOL_ROOT=${CG_TOOL_ROOT} CCS_INSTALL_DIR=${CCS_INSTALL_DIR} CCS_IDE_MODE=${CCS_IDE_MODE} DEVICE=am243x"

        enableSysConfigTool="true"
        sysConfigBuildOptions="
            --context r5fss0-0 --part ALV --package ALV
        "

        description="A TI BOARD DIAGNOSTIC NORTOS project">

        <configuration name="Debug"
            compilerBuildOptions="
                -D_DEBUG_=1
            "
            linkerBuildOptions="
                -lnortos.am243x.r5f.ti-arm-clang.debug.lib
                -ldrivers.am243x.r5f.ti-arm-clang.nortos.debug.lib
                -lboard.am243x.r5f.ti-arm-clang.nortos.debug.lib
                -llibc.a
                -llibsysbm.a
            "
        ></configuration>
        <configuration name="Release"
            compilerBuildOptions="
                -Os
            "
            linkerBuildOptions="
                -lnortos.am243x.r5f.ti-arm-clang.release.lib
                -ldrivers.am243x.r5f.ti-arm-clang.nortos.release.lib
                -lboard.am243x.r5f.ti-arm-clang.nortos.release.lib
                -llibc.a
                -llibsysbm.a
            "
        ></configuration>
        <pathVariable name="MCU_PLUS_SDK_PATH" path="${COM_TI_MCU_PLUS_SDK_AM243X_INSTALL_DIR}" scope="project" />
        <file path="../main.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../xTask_Runner.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../uart_cmd/uart_cmd_parsing.c" openOnCreation="false" targetDirectory="uart_cmd" excludeFromBuild="false" action="copy">
        </file>
        <file path="../uart_cmd/uart_echo.c" openOnCreation="false" targetDirectory="uart_cmd" excludeFromBuild="false" action="copy">
        </file>
        <file path="../source_files/board_diagnostic_init.c" openOnCreation="false" targetDirectory="source_files" excludeFromBuild="false" action="copy">
        </file>
        <file path="../source_files/can_fd_apis.c" openOnCreation="false" targetDirectory="source_files" excludeFromBuild="false" action="copy">
        </file>
        <file path="../source_files/ddr_api.c" openOnCreation="false" targetDirectory="source_files" excludeFromBuild="false" action="copy">
        </file>
        <file path="../source_files/emmc_api.c" openOnCreation="false" targetDirectory="source_files" excludeFromBuild="false" action="copy">
        </file>
        <file path="../source_files/gpio_api.c" openOnCreation="false" targetDirectory="source_files" excludeFromBuild="false" action="copy">
        </file>
        <file path="../source_files/i2c_api.c" openOnCreation="false" targetDirectory="source_files" excludeFromBuild="false" action="copy">
        </file>
        <file path="../source_files/ospi_api.c" openOnCreation="false" targetDirectory="source_files" excludeFromBuild="false" action="copy">
        </file>
        <file path="../source_files/pwm_gen.c" openOnCreation="false" targetDirectory="source_files" excludeFromBuild="false" action="copy">
        </file>
        <file path="../source_files/spi_api.c" openOnCreation="false" targetDirectory="source_files" excludeFromBuild="false" action="copy">
        </file>
        <file path="../source_files/uart_api.c" openOnCreation="false" targetDirectory="source_files" excludeFromBuild="false" action="copy">
        </file>
        <file path="../header_files/common_extern.h" openOnCreation="false" targetDirectory="header_files" excludeFromBuild="false" action="copy">
        </file>
        <file path="../header_files/global.h" openOnCreation="false" targetDirectory="header_files" excludeFromBuild="false" action="copy">
        </file>
        <file path="../header_files/uart_cmd_header.h" openOnCreation="false" targetDirectory="header_files" excludeFromBuild="false" action="copy">
        </file>
        <file path="../configurations/gpio_driver.h" openOnCreation="false" targetDirectory="configurations" excludeFromBuild="false" action="copy">
        </file>
        <file path="../configurations/gpio_driver.c" openOnCreation="false" targetDirectory="configurations" excludeFromBuild="false" action="copy">
        </file>
        <file path="../configurations/interrupt_driver.h" openOnCreation="false" targetDirectory="configurations" excludeFromBuild="false" action="copy">
        </file>
        <file path="../configurations/interrupt_driver.c" openOnCreation="false" targetDirectory="configurations" excludeFromBuild="false" action="copy">
        </file>
        <file path="../configurations/uart_driver.h" openOnCreation="false" targetDirectory="configurations" excludeFromBuild="false" action="copy">
        </file>
        <file path="../configurations/uart_driver.c" openOnCreation="false" targetDirectory="configurations" excludeFromBuild="false" action="copy">
        </file>
        <file path="../example.syscfg" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="${MCU_PLUS_SDK_PATH}/docs/api_guide_am243x/EXAMPLES_TI_BOARD_DIAGNOSTIC.html"
                openOnCreation="false" excludeFromBuild="false" targetName="README.html" action="link">
        </file>
        <file path="syscfg_c.rov.xs" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="makefile_ccs_bootimage_gen" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="makefile.defs" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
    </project>
</projectSpec>
