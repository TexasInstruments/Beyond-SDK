diff --git a/libckteec/src/pkcs11_processing.c b/libckteec/src/pkcs11_processing.c
index 9af5ecf..a924117 100644
--- a/libckteec/src/pkcs11_processing.c
+++ b/libckteec/src/pkcs11_processing.c
@@ -1705,3 +1705,219 @@ bail:
 
 	return rv;
 }
+
+/*
+ * ck_encapsulate_key - Encapsulate a key, creating a new secret key object
+ *
+ * The TA output shared memory is always library-allocated (never the
+ * caller's own ciphertext buffer, unlike ck_wrap_key()) since it packs
+ * [object handle][ciphertext] together; the ciphertext portion is copied
+ * out to the caller's buffer afterward.
+ */
+CK_RV ck_encapsulate_key(CK_SESSION_HANDLE session, CK_MECHANISM_PTR mechanism,
+			 CK_OBJECT_HANDLE public_key, CK_ATTRIBUTE_PTR attribs,
+			 CK_ULONG count, CK_BYTE_PTR ciphertext,
+			 CK_ULONG_PTR ciphertext_len,
+			 CK_OBJECT_HANDLE_PTR handle)
+{
+	CK_RV rv = CKR_GENERAL_ERROR;
+	TEEC_SharedMemory *ctrl = NULL;
+	TEEC_SharedMemory *out_shm = NULL;
+	struct serializer smecha = { 0 };
+	struct serializer sattr = { 0 };
+	uint32_t session_handle = session;
+	uint32_t pub_key_handle = public_key;
+	uint32_t key_handle = 0;
+	const size_t hdr_size = sizeof(key_handle);
+	size_t ctrl_size = 0;
+	size_t out_size = 0;
+	char *buf = NULL;
+
+	if (!handle || !mechanism || !ciphertext_len || (count && !attribs))
+		return CKR_ARGUMENTS_BAD;
+
+	if (!public_key)
+		return CKR_KEY_HANDLE_INVALID;
+
+	rv = serialize_ck_mecha_params(&smecha, mechanism);
+	if (rv)
+		return rv;
+
+	rv = serialize_ck_attributes(&sattr, attribs, count);
+	if (rv)
+		goto bail;
+
+	/*
+	 * Shm io0: (in/out) ctrl
+	 * (in) [session-handle][public-key-handle][serialized-mecha]
+	 *      [serialized-attributes]
+	 * (out) [status]
+	 */
+	ctrl_size = sizeof(session_handle) + sizeof(pub_key_handle) +
+		    smecha.size + sattr.size;
+
+	ctrl = ckteec_alloc_shm(ctrl_size, CKTEEC_SHM_INOUT);
+	if (!ctrl) {
+		rv = CKR_HOST_MEMORY;
+		goto bail;
+	}
+
+	buf = ctrl->buffer;
+
+	memcpy(buf, &session_handle, sizeof(session_handle));
+	buf += sizeof(session_handle);
+
+	memcpy(buf, &pub_key_handle, sizeof(pub_key_handle));
+	buf += sizeof(pub_key_handle);
+
+	memcpy(buf, smecha.buffer, smecha.size);
+	buf += smecha.size;
+
+	memcpy(buf, sattr.buffer, sattr.size);
+
+	/* Shm io2: output buffer reference - [object handle][ciphertext] */
+	if (ciphertext && *ciphertext_len)
+		out_shm = ckteec_alloc_shm(hdr_size + *ciphertext_len,
+					   CKTEEC_SHM_OUT);
+	else
+		/* Query output data size */
+		out_shm = ckteec_alloc_shm(hdr_size, CKTEEC_SHM_OUT);
+
+	if (!out_shm) {
+		rv = CKR_HOST_MEMORY;
+		goto bail;
+	}
+
+	rv = ckteec_invoke_ta(PKCS11_CMD_ENCAPSULATE_KEY, ctrl, NULL, out_shm,
+			      &out_size, NULL, NULL);
+
+	if (rv != CKR_OK && rv != CKR_BUFFER_TOO_SMALL)
+		goto bail;
+
+	if (out_size < hdr_size) {
+		rv = CKR_DEVICE_ERROR;
+		goto bail;
+	}
+
+	*ciphertext_len = out_size - hdr_size;
+
+	if (rv == CKR_BUFFER_TOO_SMALL && !ciphertext)
+		rv = CKR_OK;
+
+	if (rv == CKR_OK && ciphertext) {
+		memcpy(&key_handle, out_shm->buffer, hdr_size);
+		memcpy(ciphertext, (char *)out_shm->buffer + hdr_size,
+		       *ciphertext_len);
+		*handle = key_handle;
+	}
+
+bail:
+	ckteec_free_shm(out_shm);
+	ckteec_free_shm(ctrl);
+	release_serial_object(&sattr);
+	release_serial_object(&smecha);
+
+	return rv;
+}
+
+/*
+ * ck_decapsulate_key - Decapsulate a ciphertext, creating a new secret key
+ *                       object from the recovered shared secret
+ */
+CK_RV ck_decapsulate_key(CK_SESSION_HANDLE session, CK_MECHANISM_PTR mechanism,
+			 CK_OBJECT_HANDLE private_key, CK_ATTRIBUTE_PTR attribs,
+			 CK_ULONG count, CK_BYTE_PTR ciphertext,
+			 CK_ULONG ciphertext_len, CK_OBJECT_HANDLE_PTR handle)
+{
+	CK_RV rv = CKR_GENERAL_ERROR;
+	TEEC_SharedMemory *ctrl = NULL;
+	TEEC_SharedMemory *in_shm = NULL;
+	TEEC_SharedMemory *out_shm = NULL;
+	struct serializer smecha = { 0 };
+	struct serializer sattr = { 0 };
+	uint32_t session_handle = session;
+	uint32_t priv_key_handle = private_key;
+	uint32_t key_handle = 0;
+	size_t ctrl_size = 0;
+	size_t out_size = 0;
+	char *buf = NULL;
+
+	if (!handle || !mechanism || (count && !attribs) ||
+	    (ciphertext_len && !ciphertext))
+		return CKR_ARGUMENTS_BAD;
+
+	if (!private_key)
+		return CKR_KEY_HANDLE_INVALID;
+
+	rv = serialize_ck_mecha_params(&smecha, mechanism);
+	if (rv)
+		return rv;
+
+	rv = serialize_ck_attributes(&sattr, attribs, count);
+	if (rv)
+		goto bail;
+
+	/*
+	 * Shm io0: (in/out) ctrl
+	 * (in) [session-handle][private-key-handle][serialized-mecha]
+	 *      [serialized-attributes]
+	 * (out) [status]
+	 */
+	ctrl_size = sizeof(session_handle) + sizeof(priv_key_handle) +
+		    smecha.size + sattr.size;
+
+	ctrl = ckteec_alloc_shm(ctrl_size, CKTEEC_SHM_INOUT);
+	if (!ctrl) {
+		rv = CKR_HOST_MEMORY;
+		goto bail;
+	}
+
+	buf = ctrl->buffer;
+
+	memcpy(buf, &session_handle, sizeof(session_handle));
+	buf += sizeof(session_handle);
+
+	memcpy(buf, &priv_key_handle, sizeof(priv_key_handle));
+	buf += sizeof(priv_key_handle);
+
+	memcpy(buf, smecha.buffer, smecha.size);
+	buf += smecha.size;
+
+	memcpy(buf, sattr.buffer, sattr.size);
+
+	/* Shm io1: input - ciphertext buffer */
+	in_shm = ckteec_register_shm(ciphertext, ciphertext_len,
+				     CKTEEC_SHM_IN);
+	if (!in_shm) {
+		rv = CKR_HOST_MEMORY;
+		goto bail;
+	}
+
+	/* Shm io2: (out) [object handle] */
+	out_shm = ckteec_alloc_shm(sizeof(key_handle), CKTEEC_SHM_OUT);
+	if (!out_shm) {
+		rv = CKR_HOST_MEMORY;
+		goto bail;
+	}
+
+	rv = ckteec_invoke_ta(PKCS11_CMD_DECAPSULATE_KEY, ctrl, in_shm,
+			      out_shm, &out_size, NULL, NULL);
+
+	if (rv != CKR_OK || out_size != out_shm->size) {
+		if (rv == CKR_OK)
+			rv = CKR_DEVICE_ERROR;
+		goto bail;
+	}
+
+	memcpy(&key_handle, out_shm->buffer, sizeof(key_handle));
+	*handle = key_handle;
+
+bail:
+	ckteec_free_shm(out_shm);
+	ckteec_free_shm(in_shm);
+	ckteec_free_shm(ctrl);
+	release_serial_object(&sattr);
+	release_serial_object(&smecha);
+
+	return rv;
+}
