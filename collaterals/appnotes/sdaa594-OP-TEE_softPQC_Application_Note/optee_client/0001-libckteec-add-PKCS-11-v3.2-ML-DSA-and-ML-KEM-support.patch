+				 CK_OBJECT_HANDLE hObject); \
+	CK_RV (*C_GetObjectSize)(CK_SESSION_HANDLE hSession, \
+				 CK_OBJECT_HANDLE hObject, \
+				 CK_ULONG_PTR pulSize); \
+	CK_RV (*C_GetAttributeValue)(CK_SESSION_HANDLE hSession, \
+				     CK_OBJECT_HANDLE hObject, \
+				     CK_ATTRIBUTE_PTR pTemplate, \
+				     CK_ULONG ulCount); \
