 libckteec/include/pkcs11.h        | 481 ++++++++++++++++++++++++++++++
 libckteec/include/pkcs11_ta.h     | 157 +++++++++-
 libckteec/src/pkcs11_api.c        | 233 +++++++++++++++
 libckteec/src/pkcs11_processing.c | 216 ++++++++++++++
 libckteec/src/pkcs11_processing.h |  11 +
 libckteec/src/serialize_ck.c      |  16 +
 6 files changed, 1101 insertions(+), 13 deletions(-)

diff --git a/libckteec/include/pkcs11.h b/libckteec/include/pkcs11.h
index 6d7a0f7..6ef09c8 100644
--- a/libckteec/include/pkcs11.h
+++ b/libckteec/include/pkcs11.h
@@ -41,6 +41,7 @@ typedef CK_BYTE CK_BBOOL;
 #define CK_FALSE		0
 
 typedef CK_ULONG CK_FLAGS;
+typedef CK_FLAGS *CK_FLAGS_PTR;
 
 #define CK_UNAVAILABLE_INFORMATION	(~0UL)
 #define CK_EFFECTIVELY_INFINITE		0UL
@@ -199,6 +200,14 @@ struct CK_ATTRIBUTE {
 #define CKA_SUPPORTED_CMS_ATTRIBUTES	0x0503
 #define CKA_ALLOWED_MECHANISMS		(0x0600 | CKF_ARRAY_ATTRIBUTE)
 
+/* PKCS#11 v3.2 (ML-KEM/ML-DSA) */
+#define CKA_PARAMETER_SET		0x061d
+#define CKA_SEED			0x0637
+#define CKA_ENCAPSULATE			0x0633
+#define CKA_DECAPSULATE			0x0634
+#define CKA_ENCAPSULATE_TEMPLATE	(0x062a | CKF_ARRAY_ATTRIBUTE)
+#define CKA_DECAPSULATE_TEMPLATE	(0x062b | CKF_ARRAY_ATTRIBUTE)
+
 /* Attribute CKA_CLASS refers to a CK_OBJECT_CLASS typed value */
 typedef CK_ULONG CK_OBJECT_CLASS;
 typedef CK_OBJECT_CLASS *CK_OBJECT_CLASS_PTR;
@@ -241,6 +250,8 @@ typedef CK_KEY_TYPE *CK_KEY_TYPE_PTR;
 #define CKK_SHA512_HMAC			0x02d
 #define CKK_SHA224_HMAC			0x02e
 #define CKK_EC_EDWARDS			0x040 /* PKCS#11 v3.1-cs01 */
+#define CKK_ML_DSA			0x04a /* PKCS#11 v3.2 */
+#define CKK_ML_KEM			0x049 /* PKCS#11 v3.2 */
 
 /*
  * Certificates
@@ -289,6 +300,10 @@ typedef CK_MECHANISM_TYPE *CK_MECHANISM_TYPE_PTR;
 #define CKM_RSA_PKCS_OAEP		0x00009
 #define CKM_RSA_PKCS_PSS		0x0000d
 #define CKM_SHA1_RSA_PKCS_PSS		0x0000e
+#define CKM_ML_KEM_KEY_PAIR_GEN		0x0000f /* PKCS#11 v3.2 */
+#define CKM_ML_KEM			0x00017 /* PKCS#11 v3.2 */
+#define CKM_ML_DSA_KEY_PAIR_GEN		0x0001c /* PKCS#11 v3.2 */
+#define CKM_ML_DSA			0x0001d /* PKCS#11 v3.2 */
 #define CKM_SHA256_RSA_PKCS		0x00040
 #define CKM_SHA384_RSA_PKCS		0x00041
 #define CKM_SHA512_RSA_PKCS		0x00042
@@ -656,6 +671,20 @@ typedef CK_ULONG CK_RV;
 #define CKR_PIN_TOO_WEAK			0x01b8
 #define CKR_PUBLIC_KEY_INVALID			0x01b9
 #define CKR_FUNCTION_REJECTED			0x0200
+#define CKR_PARAMETER_SET_NOT_SUPPORTED		0x0209 /* PKCS#11 v3.2 */
+
+/*
+ * Attribute CKA_PARAMETER_SET refers to a CK_ULONG typed value.
+ * Values for ML-DSA parameter sets (PKCS#11 v3.2).
+ */
+#define CKP_ML_DSA_44			1
+#define CKP_ML_DSA_65			2
+#define CKP_ML_DSA_87			3
+
+/* Values for ML-KEM parameter sets (PKCS#11 v3.2) */
+#define CKP_ML_KEM_512			1
+#define CKP_ML_KEM_768			2
+#define CKP_ML_KEM_1024			3
 
 /*
  * PKCS#11 API functions
@@ -993,6 +1022,434 @@ struct CK_FUNCTION_LIST {
 				    CK_VOID_PTR pReserved);
 };
 
+/*
+ * PKCS#11 v3.0+ Interfaces mechanism (C_GetInterfaceList/C_GetInterface).
+ * CK_INTERFACE lets a caller ask for a function list by name/version
+ * instead of relying on the single, frozen v2.40 CK_FUNCTION_LIST above.
+ */
+typedef struct CK_INTERFACE CK_INTERFACE;
+typedef struct CK_INTERFACE *CK_INTERFACE_PTR;
+typedef struct CK_INTERFACE **CK_INTERFACE_PTR_PTR;
+
+struct CK_INTERFACE {
+	CK_UTF8CHAR_PTR pInterfaceName;
+	CK_VOID_PTR pFunctionList;
+	CK_FLAGS flags;
+};
+
+/* Flags for CK_INTERFACE.flags */
+#define CKF_INTERFACE_FORK_SAFE	(1U << 0)
+
+/* Types needed by the v3.2-only CK_FUNCTION_LIST_3_2 members below */
+typedef struct CK_ASYNC_DATA CK_ASYNC_DATA;
+typedef struct CK_ASYNC_DATA *CK_ASYNC_DATA_PTR;
+
+struct CK_ASYNC_DATA {
+	CK_ULONG ulVersion;
+	CK_BYTE_PTR pValue;
+	CK_ULONG ulValue;
+	CK_OBJECT_HANDLE hObject;
+	CK_OBJECT_HANDLE hAdditionalObject;
+};
+
+typedef CK_ULONG CK_SESSION_VALIDATION_FLAGS_TYPE;
+
+/*
+ * Argument for C_GetInterfaceList/C_GetInterface. CK_FUNCTION_LIST_3_0 and
+ * CK_FUNCTION_LIST_3_2 are strict, in-order extensions of CK_FUNCTION_LIST
+ * above: 3_0 appends the 24 functions introduced in PKCS#11 v3.0, and 3_2
+ * appends the 12 more introduced in v3.2. Members this library does not
+ * implement are declared with their real spec signature (for type
+ * correctness) but left unset (NULL) in the struct literal that
+ * instantiates them - callers of the Interfaces API are required to
+ * NULL-check optional members before calling them.
+ */
+typedef struct CK_FUNCTION_LIST_3_0 CK_FUNCTION_LIST_3_0;
+typedef struct CK_FUNCTION_LIST_3_0 *CK_FUNCTION_LIST_3_0_PTR;
+typedef struct CK_FUNCTION_LIST_3_0 **CK_FUNCTION_LIST_3_0_PTR_PTR;
+
+typedef struct CK_FUNCTION_LIST_3_2 CK_FUNCTION_LIST_3_2;
+typedef struct CK_FUNCTION_LIST_3_2 *CK_FUNCTION_LIST_3_2_PTR;
+typedef struct CK_FUNCTION_LIST_3_2 **CK_FUNCTION_LIST_3_2_PTR_PTR;
+
