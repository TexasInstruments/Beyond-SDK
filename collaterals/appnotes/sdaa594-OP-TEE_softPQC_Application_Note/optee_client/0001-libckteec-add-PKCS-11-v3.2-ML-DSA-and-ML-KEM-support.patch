+				 CK_ULONG ulEncryptedPartLen, \
+				 CK_BYTE_PTR pPart, CK_ULONG_PTR pulPartLen); \
+	CK_RV (*C_DecryptFinal)(CK_SESSION_HANDLE hSession, \
+				CK_BYTE_PTR pLastPart, \
+				CK_ULONG_PTR pulLastPartLen); \
