+// SPDX-License-Identifier: GPL-2.0
+/*
+ * PKCS#11 v3.2 post-quantum mechanisms (ML-DSA-44, ML-DSA-65, ML-DSA-87,
+ * ML-KEM-512, ML-KEM-768, ML-KEM-1024) runtime validation. Modeled on the
+ * key generation / sign-verify / derive patterns already used throughout
+ * pkcs11_1000.c, reusing its session/token setup helpers (declared in
+ * pkcs11_1000.h) instead of duplicating them.
+ */
+
+#include <pkcs11.h>
+#include <stdint.h>
+#include <string.h>
+#include <util.h>
+
+#include "pkcs11_1000.h"
+#include "xtest_test.h"
+#include "xtest_helpers.h"
+
+static void xtest_pkcs11_test_1100(ADBG_Case_t *c)
+{
+	CK_RV rv = CKR_GENERAL_ERROR;
+	CK_SLOT_ID slot = 0;
+	CK_SESSION_HANDLE session = CK_INVALID_HANDLE;
+	CK_FLAGS session_flags = CKF_SERIAL_SESSION | CKF_RW_SESSION;
+	CK_OBJECT_HANDLE public_key = CK_INVALID_HANDLE;
+	CK_OBJECT_HANDLE private_key = CK_INVALID_HANDLE;
+	CK_MECHANISM keygen_mechanism = { CKM_ML_DSA_KEY_PAIR_GEN, NULL, 0 };
+	CK_MECHANISM sign_mechanism = { CKM_ML_DSA, NULL, 0 };
+	CK_ULONG param_set = CKP_ML_DSA_65;
+	CK_BBOOL btrue = CK_TRUE;
+	CK_BBOOL bfalse = CK_FALSE;
+	CK_ATTRIBUTE public_key_template[] = {
+		{ CKA_PARAMETER_SET, &param_set, sizeof(param_set) },
+		{ CKA_VERIFY, &btrue, sizeof(btrue) },
+	};
+	CK_ATTRIBUTE private_key_template[] = {
+		{ CKA_PARAMETER_SET, &param_set, sizeof(param_set) },
+		{ CKA_TOKEN, &bfalse, sizeof(bfalse) },
+		{ CKA_SIGN, &btrue, sizeof(btrue) },
+	};
+	const CK_BYTE message[] = "OP-TEE PKCS#11 ML-DSA-65 xtest message";
+	CK_BYTE tampered[sizeof(message)] = { 0 };
+	CK_BYTE signature[3309] = { 0 };
+	CK_ULONG signature_len = 0;
+
+	rv = init_lib_and_find_token_slot(&slot, PIN_AUTH);
+	if (!ADBG_EXPECT_CK_OK(c, rv))
+		return;
+
+	rv = init_test_token_pin_auth(slot);
+	if (!ADBG_EXPECT_CK_OK(c, rv))
+		goto close_lib;
+
+	rv = init_user_test_token_pin_auth(slot);
+	if (!ADBG_EXPECT_CK_OK(c, rv))
+		goto close_lib;
+
+	rv = C_OpenSession(slot, session_flags, NULL, 0, &session);
+	if (!ADBG_EXPECT_CK_OK(c, rv))
+		goto close_lib;
+
+	rv = C_Login(session, CKU_USER, test_token_user_pin,
+		     sizeof(test_token_user_pin));
+	if (!ADBG_EXPECT_CK_OK(c, rv))
+		goto out;
+
+	Do_ADBG_BeginSubCase(c, "ML-DSA-65: Generate key pair");
+
+	rv = C_GenerateKeyPair(session, &keygen_mechanism,
+			       public_key_template,
+			       ARRAY_SIZE(public_key_template),
+			       private_key_template,
+			       ARRAY_SIZE(private_key_template),
+			       &public_key, &private_key);
+	if (!ADBG_EXPECT_CK_OK(c, rv))
+		goto err;
+
+	Do_ADBG_EndSubCase(c, NULL);
+	Do_ADBG_BeginSubCase(c, "ML-DSA-65: Sign & verify - oneshot");
+
+	signature_len = sizeof(signature);
+	rv = C_SignInit(session, &sign_mechanism, private_key);
+	if (!ADBG_EXPECT_CK_OK(c, rv))
+		goto err_destr_keys;
+
+	rv = C_Sign(session, (void *)message, sizeof(message), signature,
+		    &signature_len);
+	if (!ADBG_EXPECT_CK_OK(c, rv))
+		goto err_destr_keys;
+
+	rv = C_VerifyInit(session, &sign_mechanism, public_key);
+	if (!ADBG_EXPECT_CK_OK(c, rv))
+		goto err_destr_keys;
+
+	rv = C_Verify(session, (void *)message, sizeof(message), signature,
+		      signature_len);
+	if (!ADBG_EXPECT_CK_OK(c, rv))
+		goto err_destr_keys;
+
+	Do_ADBG_EndSubCase(c, NULL);
+	Do_ADBG_BeginSubCase(c, "ML-DSA-65: Verify rejects a tampered message");
+
+	memcpy(tampered, message, sizeof(message));
+	tampered[0] ^= 1;
+
+	rv = C_VerifyInit(session, &sign_mechanism, public_key);
+	if (!ADBG_EXPECT_CK_OK(c, rv))
+		goto err_destr_keys;
+
+	rv = C_Verify(session, tampered, sizeof(tampered), signature,
+		      signature_len);
+	if (!ADBG_EXPECT_CK_RESULT(c, CKR_SIGNATURE_INVALID, rv))
+		goto err_destr_keys;
+
+	Do_ADBG_EndSubCase(c, NULL);
+	Do_ADBG_BeginSubCase(c, "ML-DSA-65: Destroy keys");
+
+	rv = C_DestroyObject(session, private_key);
+	if (!ADBG_EXPECT_CK_OK(c, rv))
+		goto err;
+
+	rv = C_DestroyObject(session, public_key);
+	if (!ADBG_EXPECT_CK_OK(c, rv))
+		goto err;
+
+	Do_ADBG_EndSubCase(c, NULL);
+	goto out;
+
+err_destr_keys:
+	ADBG_EXPECT_CK_OK(c, C_DestroyObject(session, private_key));
+	ADBG_EXPECT_CK_OK(c, C_DestroyObject(session, public_key));
+err:
+	Do_ADBG_EndSubCase(c, NULL);
+out:
+	ADBG_EXPECT_CK_OK(c, C_CloseSession(session));
+close_lib:
+	ADBG_EXPECT_CK_OK(c, close_lib());
+}
