diff --git a/ta/pkcs11/src/processing_pqc.c b/ta/pkcs11/src/processing_pqc.c
new file mode 100644
index 000000000..8491ab1ce
--- /dev/null
+++ b/ta/pkcs11/src/processing_pqc.c
@@ -0,0 +1,730 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Post-quantum (PKCS#11 v3.2) mechanisms: ML-DSA-44/65/87 signatures and
+ * ML-KEM-512/768/1024 key encapsulation.
+ *
+ * Unlike RSA/EC/EdDSA, there is no GlobalPlatform TEE Internal Core API
+ * algorithm for ML-DSA or ML-KEM, so neither mechanism ever allocates a
+ * TEE_OperationHandle or a TEE_ObjectHandle: key material is kept as plain
+ * byte blobs in the object's attribute list and the vendored
+ * mldsa-native/mlkem-native reference implementations
+ * (ta/pkcs11/mldsa-native and ta/pkcs11/mlkem-native) are
+ * called directly on it. All three parameter sets of each mechanism are
+ * compiled in whenever CFG_PKCS11_TA_ML_DSA=y / CFG_PKCS11_TA_ML_KEM=y and
+ * coexist at runtime, selected per key via CKA_PARAMETER_SET.
+ */
+
+#include <assert.h>
+#include <inttypes.h>
+#include <pkcs11_ta.h>
+#include <tee_internal_api.h>
+
+#include "attributes.h"
+#include "pkcs11_helpers.h"
+#include "pkcs11_token.h"
+#include "processing.h"
+#include "serializer.h"
+
+#if defined(CFG_PKCS11_TA_ML_DSA) || defined(CFG_PKCS11_TA_ML_KEM)
+/*
+ * CKA_PARAMETER_SET is optional on the private key template: when the
+ * caller omits it, the *_opt_or_null attribute processing still adds it
+ * to the object with a zero-length value rather than leaving it absent
+ * (see set_attributes_opt_or_null()). Treat that empty-but-present case
+ * the same as PKCS11_RV_NOT_FOUND.
+ */
+static enum pkcs11_rc check_parameter_set(struct obj_attrs *head,
+					  uint32_t expected_parameter_set)
+{
+	void *value = NULL;
+	uint32_t size = 0;
+	enum pkcs11_rc rc = get_attribute_ptr(head, PKCS11_CKA_PARAMETER_SET,
+					      &value, &size);
+
+	if (rc == PKCS11_RV_NOT_FOUND || (!rc && !size))
+		return PKCS11_CKR_OK;
+
+	if (rc)
+		return rc;
+
+	if (size != sizeof(uint32_t) ||
+	    *(uint32_t *)value != expected_parameter_set)
+		return PKCS11_CKR_PARAMETER_SET_NOT_SUPPORTED;
+
+	return PKCS11_CKR_OK;
+}
+
+/*
+ * add_attribute() always appends rather than replacing: if the template's
+ * *_opt_or_null processing already left a zero-length CKA_PARAMETER_SET
+ * placeholder on this object (see check_parameter_set() above), blindly
+ * adding another one creates a duplicate. Since get_attribute_ptr() (used
+ * by both check_parameter_set() and the client's C_GetAttributeValue)
+ * returns the first match, that duplicate would leave the empty
+ * placeholder permanently shadowing the real value. Remove the empty
+ * placeholder, if any, before adding the resolved value. If a non-empty
+ * value is already present, it was already validated by
+ * check_parameter_set() - leave it as is rather than duplicating it.
+ */
+static enum pkcs11_rc set_parameter_set_attribute(struct obj_attrs **head,
+						  uint32_t parameter_set)
+{
+	enum pkcs11_rc rc = remove_empty_attribute(head,
+						   PKCS11_CKA_PARAMETER_SET);
+
+	if (rc == PKCS11_CKR_FUNCTION_FAILED)
+		return PKCS11_CKR_OK;
+
+	if (rc && rc != PKCS11_RV_NOT_FOUND)
+		return rc;
+
+	return add_attribute(head, PKCS11_CKA_PARAMETER_SET, &parameter_set,
+			     sizeof(parameter_set));
+}
+#endif /* CFG_PKCS11_TA_ML_DSA || CFG_PKCS11_TA_ML_KEM */
+
+#ifdef CFG_PKCS11_TA_ML_DSA
+#include <mldsa_native_all.h>
+
+/*
+ * CKA_PARAMETER_SET is mandatory on the public key template (see the
+ * comment on mldsa_key_mandated[] in pkcs11_attributes.c), so by the time
+ * generate_mldsa_keys() runs it is always present with a real value -
+ * except when called on a template built before this file's own
+ * *_opt_or_null default-value processing ran, hence the defensive
+ * NOT_FOUND/empty fallback to ML-DSA-65 here, matching this mechanism's
+ * original (pre-ML-DSA-87) single-parameter-set behaviour.
+ */
+static enum pkcs11_rc get_mldsa_parameter_set(struct obj_attrs *head,
+					      uint32_t *parameter_set)
+{
+	void *value = NULL;
+	uint32_t size = 0;
+	enum pkcs11_rc rc = get_attribute_ptr(head, PKCS11_CKA_PARAMETER_SET,
+					      &value, &size);
+
+	if (rc == PKCS11_RV_NOT_FOUND || (!rc && !size)) {
+		*parameter_set = PKCS11_CKP_ML_DSA_65;
+		return PKCS11_CKR_OK;
+	}
+
+	if (rc)
+		return rc;
+
+	if (size != sizeof(*parameter_set))
+		return PKCS11_CKR_ATTRIBUTE_VALUE_INVALID;
+
+	*parameter_set = *(uint32_t *)value;
+
+	switch (*parameter_set) {
+	case PKCS11_CKP_ML_DSA_44:
+	case PKCS11_CKP_ML_DSA_65:
+	case PKCS11_CKP_ML_DSA_87:
+		return PKCS11_CKR_OK;
+	default:
+		return PKCS11_CKR_PARAMETER_SET_NOT_SUPPORTED;
+	}
+}
+
+enum pkcs11_rc generate_mldsa_keys(struct pkcs11_attribute_head *proc_params,
+				   struct obj_attrs **pub_head,
+				   struct obj_attrs **priv_head)
+{
+	uint8_t pub_key[MLDSA_PUBLICKEYBYTES(87)] = { };
+	uint8_t priv_key[MLDSA_SECRETKEYBYTES(87)] = { };
+	uint32_t parameter_set = PKCS11_CKP_UNDEFINED_ID;
+	uint32_t pub_key_size = 0;
+	uint32_t priv_key_size = 0;
+	enum pkcs11_rc rc = PKCS11_CKR_OK;
+
+	if (proc_params->size) {
+		EMSG("Invalid parameter for mechanism %#"PRIx32,
+		     proc_params->id);
+		return PKCS11_CKR_MECHANISM_PARAM_INVALID;
+	}
+
+	rc = get_mldsa_parameter_set(*pub_head, &parameter_set);
+	if (rc)
+		return rc;
+
+	rc = check_parameter_set(*pub_head, parameter_set);
+	if (rc)
+		return rc;
+
+	rc = check_parameter_set(*priv_head, parameter_set);
+	if (rc)
+		return rc;
+
+	if (remove_empty_attribute(pub_head, PKCS11_CKA_VALUE) ==
+	    PKCS11_CKR_FUNCTION_FAILED ||
+	    remove_empty_attribute(priv_head, PKCS11_CKA_VALUE) ==
+	    PKCS11_CKR_FUNCTION_FAILED) {
+		EMSG("Unexpected CKA_VALUE found in template");
+		return PKCS11_CKR_TEMPLATE_INCONSISTENT;
+	}
+
+	switch (parameter_set) {
+	case PKCS11_CKP_ML_DSA_44:
+		pub_key_size = MLDSA_PUBLICKEYBYTES(44);
+		priv_key_size = MLDSA_SECRETKEYBYTES(44);
+		if (pkcs11_mldsa44_keypair(pub_key, priv_key)) {
+			EMSG("ML-DSA-44 key pair generation failed");
+			return PKCS11_CKR_FUNCTION_FAILED;
+		}
+		break;
+	case PKCS11_CKP_ML_DSA_65:
+		pub_key_size = MLDSA_PUBLICKEYBYTES(65);
+		priv_key_size = MLDSA_SECRETKEYBYTES(65);
+		if (pkcs11_mldsa65_keypair(pub_key, priv_key)) {
+			EMSG("ML-DSA-65 key pair generation failed");
+			return PKCS11_CKR_FUNCTION_FAILED;
+		}
+		break;
+	case PKCS11_CKP_ML_DSA_87:
+		pub_key_size = MLDSA_PUBLICKEYBYTES(87);
+		priv_key_size = MLDSA_SECRETKEYBYTES(87);
+		if (pkcs11_mldsa87_keypair(pub_key, priv_key)) {
+			EMSG("ML-DSA-87 key pair generation failed");
+			return PKCS11_CKR_FUNCTION_FAILED;
+		}
+		break;
+	default:
+		/* Unreachable: already validated above */
+		return PKCS11_CKR_PARAMETER_SET_NOT_SUPPORTED;
+	}
+
+	rc = add_attribute(pub_head, PKCS11_CKA_VALUE, pub_key, pub_key_size);
+	if (rc)
+		goto out;
+
+	rc = set_parameter_set_attribute(pub_head, parameter_set);
+	if (rc)
+		goto out;
+
+	rc = add_attribute(priv_head, PKCS11_CKA_VALUE, priv_key,
+			   priv_key_size);
+	if (rc)
+		goto out;
+
+	rc = set_parameter_set_attribute(priv_head, parameter_set);
+
+out:
+	TEE_MemFill(priv_key, 0, sizeof(priv_key));
+
+	return rc;
+}
+
+static enum pkcs11_rc do_mldsa_sign(struct pkcs11_object *obj, void *in_buf,
+				    uint32_t in_size, void *out_buf,
+				    size_t *out_size)
+{
+	void *priv_key = NULL;
+	uint32_t priv_key_size = 0;
+	uint32_t parameter_set = PKCS11_CKP_UNDEFINED_ID;
+	enum pkcs11_rc rc = PKCS11_CKR_OK;
+
+	rc = get_mldsa_parameter_set(obj->attributes, &parameter_set);
+	if (rc)
+		return rc;
+
+	rc = get_attribute_ptr(obj->attributes, PKCS11_CKA_VALUE, &priv_key,
+			       &priv_key_size);
+	if (rc)
+		return PKCS11_CKR_GENERAL_ERROR;
+
+	switch (parameter_set) {
+	case PKCS11_CKP_ML_DSA_44:
+		if (*out_size < MLDSA_BYTES(44)) {
+			*out_size = MLDSA_BYTES(44);
+			return PKCS11_CKR_BUFFER_TOO_SMALL;
+		}
+		if (priv_key_size != MLDSA_SECRETKEYBYTES(44)) {
+			EMSG("Invalid ML-DSA-44 private key");
+			return PKCS11_CKR_GENERAL_ERROR;
+		}
+		if (pkcs11_mldsa44_signature(out_buf, in_buf, in_size, NULL,
+					     0, priv_key))
+			return PKCS11_CKR_FUNCTION_FAILED;
+		*out_size = MLDSA_BYTES(44);
+		break;
+	case PKCS11_CKP_ML_DSA_65:
+		if (*out_size < MLDSA_BYTES(65)) {
+			*out_size = MLDSA_BYTES(65);
+			return PKCS11_CKR_BUFFER_TOO_SMALL;
+		}
+		if (priv_key_size != MLDSA_SECRETKEYBYTES(65)) {
+			EMSG("Invalid ML-DSA-65 private key");
+			return PKCS11_CKR_GENERAL_ERROR;
+		}
+		if (pkcs11_mldsa65_signature(out_buf, in_buf, in_size, NULL,
+					     0, priv_key))
+			return PKCS11_CKR_FUNCTION_FAILED;
+		*out_size = MLDSA_BYTES(65);
+		break;
+	case PKCS11_CKP_ML_DSA_87:
+		if (*out_size < MLDSA_BYTES(87)) {
+			*out_size = MLDSA_BYTES(87);
+			return PKCS11_CKR_BUFFER_TOO_SMALL;
+		}
+		if (priv_key_size != MLDSA_SECRETKEYBYTES(87)) {
+			EMSG("Invalid ML-DSA-87 private key");
+			return PKCS11_CKR_GENERAL_ERROR;
+		}
+		if (pkcs11_mldsa87_signature(out_buf, in_buf, in_size, NULL,
+					     0, priv_key))
+			return PKCS11_CKR_FUNCTION_FAILED;
+		*out_size = MLDSA_BYTES(87);
+		break;
+	default:
+		/* Unreachable: already validated above */
+		return PKCS11_CKR_GENERAL_ERROR;
+	}
+
+	return PKCS11_CKR_OK;
+}
+
+static enum pkcs11_rc do_mldsa_verify(struct pkcs11_object *obj, void *in_buf,
+				      uint32_t in_size, void *sig_buf,
+				      uint32_t sig_size)
+{
+	void *pub_key = NULL;
+	uint32_t pub_key_size = 0;
+	uint32_t parameter_set = PKCS11_CKP_UNDEFINED_ID;
+	enum pkcs11_rc rc = PKCS11_CKR_OK;
+
+	rc = get_mldsa_parameter_set(obj->attributes, &parameter_set);
+	if (rc)
+		return rc;
+
+	rc = get_attribute_ptr(obj->attributes, PKCS11_CKA_VALUE, &pub_key,
+			       &pub_key_size);
+	if (rc)
+		return PKCS11_CKR_GENERAL_ERROR;
+
+	switch (parameter_set) {
+	case PKCS11_CKP_ML_DSA_44:
+		if (sig_size != MLDSA_BYTES(44))
+			return PKCS11_CKR_SIGNATURE_LEN_RANGE;
+		if (pub_key_size != MLDSA_PUBLICKEYBYTES(44)) {
+			EMSG("Invalid ML-DSA-44 public key");
+			return PKCS11_CKR_GENERAL_ERROR;
+		}
+		if (pkcs11_mldsa44_verify(sig_buf, in_buf, in_size, NULL, 0,
+					  pub_key))
+			return PKCS11_CKR_SIGNATURE_INVALID;
+		break;
+	case PKCS11_CKP_ML_DSA_65:
+		if (sig_size != MLDSA_BYTES(65))
+			return PKCS11_CKR_SIGNATURE_LEN_RANGE;
+		if (pub_key_size != MLDSA_PUBLICKEYBYTES(65)) {
+			EMSG("Invalid ML-DSA-65 public key");
+			return PKCS11_CKR_GENERAL_ERROR;
+		}
+		if (pkcs11_mldsa65_verify(sig_buf, in_buf, in_size, NULL, 0,
+					  pub_key))
+			return PKCS11_CKR_SIGNATURE_INVALID;
+		break;
+	case PKCS11_CKP_ML_DSA_87:
+		if (sig_size != MLDSA_BYTES(87))
+			return PKCS11_CKR_SIGNATURE_LEN_RANGE;
+		if (pub_key_size != MLDSA_PUBLICKEYBYTES(87)) {
+			EMSG("Invalid ML-DSA-87 public key");
+			return PKCS11_CKR_GENERAL_ERROR;
+		}
+		if (pkcs11_mldsa87_verify(sig_buf, in_buf, in_size, NULL, 0,
+					  pub_key))
+			return PKCS11_CKR_SIGNATURE_INVALID;
+		break;
+	default:
+		/* Unreachable: already validated above */
+		return PKCS11_CKR_GENERAL_ERROR;
+	}
+
+	return PKCS11_CKR_OK;
+}
+#endif /* CFG_PKCS11_TA_ML_DSA */
+
+#ifdef CFG_PKCS11_TA_ML_KEM
+#include <mlkem_native_all.h>
+
+/*
+ * CKA_PARAMETER_SET is mandatory on the public key template for
+ * C_GenerateKeyPair (see mlkem_key_mandated[] in pkcs11_attributes.c), so
+ * by the time generate_mlkem_keys() runs it is always present with a real
+ * value - except when called on a template built before this file's own
+ * *_opt_or_null default-value processing ran, hence the defensive
+ * NOT_FOUND/empty fallback to ML-KEM-768 here, matching this mechanism's
+ * original (pre-ML-KEM-512/1024) single-parameter-set behaviour.
+ */
+static enum pkcs11_rc get_mlkem_parameter_set(struct obj_attrs *head,
+					      uint32_t *parameter_set)
+{
+	void *value = NULL;
+	uint32_t size = 0;
+	enum pkcs11_rc rc = get_attribute_ptr(head, PKCS11_CKA_PARAMETER_SET,
+					      &value, &size);
+
+	if (rc == PKCS11_RV_NOT_FOUND || (!rc && !size)) {
+		*parameter_set = PKCS11_CKP_ML_KEM_768;
+		return PKCS11_CKR_OK;
+	}
+
+	if (rc)
+		return rc;
+
+	if (size != sizeof(*parameter_set))
+		return PKCS11_CKR_ATTRIBUTE_VALUE_INVALID;
+
+	*parameter_set = *(uint32_t *)value;
+
+	switch (*parameter_set) {
+	case PKCS11_CKP_ML_KEM_512:
+	case PKCS11_CKP_ML_KEM_768:
+	case PKCS11_CKP_ML_KEM_1024:
+		return PKCS11_CKR_OK;
+	default:
+		return PKCS11_CKR_PARAMETER_SET_NOT_SUPPORTED;
+	}
+}
+
+enum pkcs11_rc generate_mlkem_keys(struct pkcs11_attribute_head *proc_params,
+				   struct obj_attrs **pub_head,
+				   struct obj_attrs **priv_head)
+{
+	uint8_t pub_key[MLKEM_PUBLICKEYBYTES(1024)] = { };
+	uint8_t priv_key[MLKEM_SECRETKEYBYTES(1024)] = { };
+	uint32_t parameter_set = PKCS11_CKP_UNDEFINED_ID;
+	uint32_t pub_key_size = 0;
+	uint32_t priv_key_size = 0;
+	enum pkcs11_rc rc = PKCS11_CKR_OK;
+
+	if (proc_params->size) {
+		EMSG("Invalid parameter for mechanism %#"PRIx32,
+		     proc_params->id);
+		return PKCS11_CKR_MECHANISM_PARAM_INVALID;
+	}
+
+	rc = get_mlkem_parameter_set(*pub_head, &parameter_set);
+	if (rc)
+		return rc;
+
+	rc = check_parameter_set(*pub_head, parameter_set);
+	if (rc)
+		return rc;
+
+	rc = check_parameter_set(*priv_head, parameter_set);
+	if (rc)
+		return rc;
+
+	if (remove_empty_attribute(pub_head, PKCS11_CKA_VALUE) ==
+	    PKCS11_CKR_FUNCTION_FAILED ||
+	    remove_empty_attribute(priv_head, PKCS11_CKA_VALUE) ==
+	    PKCS11_CKR_FUNCTION_FAILED) {
+		EMSG("Unexpected CKA_VALUE found in template");
+		return PKCS11_CKR_TEMPLATE_INCONSISTENT;
+	}
+
+	switch (parameter_set) {
+	case PKCS11_CKP_ML_KEM_512:
+		pub_key_size = MLKEM_PUBLICKEYBYTES(512);
+		priv_key_size = MLKEM_SECRETKEYBYTES(512);
+		if (pkcs11_mlkem512_keypair(pub_key, priv_key)) {
+			EMSG("ML-KEM-512 key pair generation failed");
+			return PKCS11_CKR_FUNCTION_FAILED;
+		}
+		break;
+	case PKCS11_CKP_ML_KEM_768:
+		pub_key_size = MLKEM_PUBLICKEYBYTES(768);
+		priv_key_size = MLKEM_SECRETKEYBYTES(768);
+		if (pkcs11_mlkem768_keypair(pub_key, priv_key)) {
+			EMSG("ML-KEM-768 key pair generation failed");
+			return PKCS11_CKR_FUNCTION_FAILED;
+		}
+		break;
+	case PKCS11_CKP_ML_KEM_1024:
+		pub_key_size = MLKEM_PUBLICKEYBYTES(1024);
+		priv_key_size = MLKEM_SECRETKEYBYTES(1024);
+		if (pkcs11_mlkem1024_keypair(pub_key, priv_key)) {
+			EMSG("ML-KEM-1024 key pair generation failed");
+			return PKCS11_CKR_FUNCTION_FAILED;
+		}
+		break;
+	default:
+		/* Unreachable: already validated above */
+		return PKCS11_CKR_PARAMETER_SET_NOT_SUPPORTED;
+	}
+
+	rc = add_attribute(pub_head, PKCS11_CKA_VALUE, pub_key, pub_key_size);
+	if (rc)
+		goto out;
+
+	rc = set_parameter_set_attribute(pub_head, parameter_set);
+	if (rc)
+		goto out;
+
+	rc = add_attribute(priv_head, PKCS11_CKA_VALUE, priv_key,
+			   priv_key_size);
+	if (rc)
+		goto out;
+
+	rc = set_parameter_set_attribute(priv_head, parameter_set);
+
+out:
+	TEE_MemFill(priv_key, 0, sizeof(priv_key));
+
+	return rc;
+}
+
+enum pkcs11_rc do_mlkem_encapsulate(struct pkcs11_object *pub_obj,
+				    void *ct_buf, size_t *ct_size,
+				    uint8_t shared_secret[MLKEM_BYTES])
+{
+	void *pub_key = NULL;
+	uint32_t pub_key_size = 0;
+	uint32_t parameter_set = PKCS11_CKP_UNDEFINED_ID;
+	enum pkcs11_rc rc = PKCS11_CKR_OK;
+
+	rc = get_mlkem_parameter_set(pub_obj->attributes, &parameter_set);
+	if (rc)
+		return rc;
+
+	rc = get_attribute_ptr(pub_obj->attributes, PKCS11_CKA_VALUE, &pub_key,
+			       &pub_key_size);
+	if (rc)
+		return PKCS11_CKR_GENERAL_ERROR;
+
+	switch (parameter_set) {
+	case PKCS11_CKP_ML_KEM_512:
+		if (*ct_size < MLKEM_CIPHERTEXTBYTES(512)) {
+			*ct_size = MLKEM_CIPHERTEXTBYTES(512);
+			return PKCS11_CKR_BUFFER_TOO_SMALL;
+		}
+		if (pub_key_size != MLKEM_PUBLICKEYBYTES(512)) {
+			EMSG("Invalid ML-KEM-512 public key");
+			return PKCS11_CKR_GENERAL_ERROR;
+		}
+		if (pkcs11_mlkem512_enc(ct_buf, shared_secret, pub_key))
+			return PKCS11_CKR_FUNCTION_FAILED;
+		*ct_size = MLKEM_CIPHERTEXTBYTES(512);
+		break;
+	case PKCS11_CKP_ML_KEM_768:
+		if (*ct_size < MLKEM_CIPHERTEXTBYTES(768)) {
+			*ct_size = MLKEM_CIPHERTEXTBYTES(768);
+			return PKCS11_CKR_BUFFER_TOO_SMALL;
+		}
+		if (pub_key_size != MLKEM_PUBLICKEYBYTES(768)) {
+			EMSG("Invalid ML-KEM-768 public key");
+			return PKCS11_CKR_GENERAL_ERROR;
+		}
+		if (pkcs11_mlkem768_enc(ct_buf, shared_secret, pub_key))
+			return PKCS11_CKR_FUNCTION_FAILED;
+		*ct_size = MLKEM_CIPHERTEXTBYTES(768);
+		break;
+	case PKCS11_CKP_ML_KEM_1024:
+		if (*ct_size < MLKEM_CIPHERTEXTBYTES(1024)) {
+			*ct_size = MLKEM_CIPHERTEXTBYTES(1024);
+			return PKCS11_CKR_BUFFER_TOO_SMALL;
+		}
+		if (pub_key_size != MLKEM_PUBLICKEYBYTES(1024)) {
+			EMSG("Invalid ML-KEM-1024 public key");
+			return PKCS11_CKR_GENERAL_ERROR;
+		}
+		if (pkcs11_mlkem1024_enc(ct_buf, shared_secret, pub_key))
+			return PKCS11_CKR_FUNCTION_FAILED;
+		*ct_size = MLKEM_CIPHERTEXTBYTES(1024);
+		break;
+	default:
+		/* Unreachable: already validated above */
+		return PKCS11_CKR_GENERAL_ERROR;
+	}
+
+	return PKCS11_CKR_OK;
+}
+
+enum pkcs11_rc do_mlkem_decapsulate(struct pkcs11_object *priv_obj,
+				    void *ct_buf, uint32_t ct_size,
+				    uint8_t shared_secret[MLKEM_BYTES])
+{
+	void *priv_key = NULL;
+	uint32_t priv_key_size = 0;
+	uint32_t parameter_set = PKCS11_CKP_UNDEFINED_ID;
+	enum pkcs11_rc rc = PKCS11_CKR_OK;
+
+	rc = get_mlkem_parameter_set(priv_obj->attributes, &parameter_set);
+	if (rc)
+		return rc;
+
+	rc = get_attribute_ptr(priv_obj->attributes, PKCS11_CKA_VALUE,
+			       &priv_key, &priv_key_size);
+	if (rc)
+		return PKCS11_CKR_GENERAL_ERROR;
+
+	switch (parameter_set) {
+	case PKCS11_CKP_ML_KEM_512:
+		if (ct_size != MLKEM_CIPHERTEXTBYTES(512))
+			return PKCS11_CKR_ENCRYPTED_DATA_LEN_RANGE;
+		if (priv_key_size != MLKEM_SECRETKEYBYTES(512)) {
+			EMSG("Invalid ML-KEM-512 private key");
+			return PKCS11_CKR_GENERAL_ERROR;
+		}
+		if (pkcs11_mlkem512_dec(shared_secret, ct_buf, priv_key))
+			return PKCS11_CKR_ENCRYPTED_DATA_INVALID;
+		break;
+	case PKCS11_CKP_ML_KEM_768:
+		if (ct_size != MLKEM_CIPHERTEXTBYTES(768))
+			return PKCS11_CKR_ENCRYPTED_DATA_LEN_RANGE;
+		if (priv_key_size != MLKEM_SECRETKEYBYTES(768)) {
+			EMSG("Invalid ML-KEM-768 private key");
+			return PKCS11_CKR_GENERAL_ERROR;
+		}
+		if (pkcs11_mlkem768_dec(shared_secret, ct_buf, priv_key))
+			return PKCS11_CKR_ENCRYPTED_DATA_INVALID;
+		break;
+	case PKCS11_CKP_ML_KEM_1024:
+		if (ct_size != MLKEM_CIPHERTEXTBYTES(1024))
+			return PKCS11_CKR_ENCRYPTED_DATA_LEN_RANGE;
+		if (priv_key_size != MLKEM_SECRETKEYBYTES(1024)) {
+			EMSG("Invalid ML-KEM-1024 private key");
+			return PKCS11_CKR_GENERAL_ERROR;
+		}
+		if (pkcs11_mlkem1024_dec(shared_secret, ct_buf, priv_key))
+			return PKCS11_CKR_ENCRYPTED_DATA_INVALID;
+		break;
+	default:
+		/* Unreachable: already validated above */
+		return PKCS11_CKR_GENERAL_ERROR;
+	}
+
+	return PKCS11_CKR_OK;
+}
+#endif /* CFG_PKCS11_TA_ML_KEM */
+
+bool processing_is_tee_pqc(uint32_t proc_id)
+{
+	switch (proc_id) {
+#ifdef CFG_PKCS11_TA_ML_DSA
+	case PKCS11_CKM_ML_DSA:
+		return true;
+#endif
+	default:
+		return false;
+	}
+}
+
+/*
+ * init_pqc_operation() / step_pqc_operation() are always linkable: they are
+ * called unconditionally from processing.c, gated at runtime by
+ * processing_is_tee_pqc() (which returns false for every mechanism when no
+ * PQC feature is enabled, making the switches below unreachable dead code
+ * in that configuration).
+ */
+enum pkcs11_rc init_pqc_operation(struct pkcs11_session *session,
+				  enum processing_func function,
+				  struct pkcs11_attribute_head *proc_params,
+				  struct pkcs11_object *obj)
+{
+	assert(processing_is_tee_pqc(proc_params->id));
+
+	if (proc_params->size)
+		return PKCS11_CKR_MECHANISM_PARAM_INVALID;
+
+	switch (proc_params->id) {
+#ifdef CFG_PKCS11_TA_ML_DSA
+	case PKCS11_CKM_ML_DSA:
+		if (function != PKCS11_FUNCTION_SIGN &&
+		    function != PKCS11_FUNCTION_VERIFY)
+			return PKCS11_CKR_MECHANISM_INVALID;
+		break;
+#endif
+	default:
+		return PKCS11_CKR_MECHANISM_INVALID;
+	}
+
+	/*
+	 * extra_ctx is always expected to be a TEE_Malloc()'d buffer owned by
+	 * the active processing state: release_active_processing() calls
+	 * TEE_Free() on it unconditionally. obj is a borrowed pointer into
+	 * the live object store, not owned here, so it must not be stored
+	 * directly - wrap it in a small heap allocation instead.
+	 */
+	session->processing->extra_ctx = TEE_Malloc(sizeof(obj), 0);
+	if (!session->processing->extra_ctx)
+		return PKCS11_CKR_DEVICE_MEMORY;
+
+	*(struct pkcs11_object **)session->processing->extra_ctx = obj;
+	session->processing->mecha_type = proc_params->id;
+
+	return PKCS11_CKR_OK;
+}
+
+enum pkcs11_rc step_pqc_operation(struct pkcs11_session *session,
+				  enum processing_func function,
+				  enum processing_step step,
+				  uint32_t ptypes, TEE_Param *params)
+{
+	struct active_processing *proc = session->processing;
+	enum pkcs11_rc rc = PKCS11_CKR_GENERAL_ERROR;
+
+	/* Pure ML-DSA signs/verifies the whole message in a single call */
+	if (step != PKCS11_FUNC_STEP_ONESHOT)
+		return PKCS11_CKR_MECHANISM_INVALID;
+
+	switch (proc->mecha_type) {
+#ifdef CFG_PKCS11_TA_ML_DSA
+	case PKCS11_CKM_ML_DSA: {
+		struct pkcs11_object *obj = *(struct pkcs11_object **)proc->extra_ctx;
+		void *in_buf = NULL;
+		uint32_t in_size = 0;
+		void *sig_buf = NULL;
+		uint32_t sig_size = 0;
+		size_t out_size = 0;
+
+		if (TEE_PARAM_TYPE_GET(ptypes, 1) ==
+		    TEE_PARAM_TYPE_MEMREF_INPUT) {
+			in_buf = params[1].memref.buffer;
+			in_size = params[1].memref.size;
+			if (in_size && !in_buf)
+				return PKCS11_CKR_ARGUMENTS_BAD;
+		}
+
+		switch (function) {
+		case PKCS11_FUNCTION_SIGN:
+			if (TEE_PARAM_TYPE_GET(ptypes, 2) !=
+			    TEE_PARAM_TYPE_MEMREF_OUTPUT)
+				return PKCS11_CKR_ARGUMENTS_BAD;
+
+			out_size = params[2].memref.size;
+			rc = do_mldsa_sign(obj, in_buf, in_size,
+					   params[2].memref.buffer,
+					   &out_size);
+			if (rc == PKCS11_CKR_OK ||
+			    rc == PKCS11_CKR_BUFFER_TOO_SMALL)
+				params[2].memref.size = out_size;
+			break;
+		case PKCS11_FUNCTION_VERIFY:
+			if (TEE_PARAM_TYPE_GET(ptypes, 2) !=
+			    TEE_PARAM_TYPE_MEMREF_INPUT)
+				return PKCS11_CKR_ARGUMENTS_BAD;
+
+			sig_buf = params[2].memref.buffer;
+			sig_size = params[2].memref.size;
+			if (sig_size && !sig_buf)
+				return PKCS11_CKR_ARGUMENTS_BAD;
+
+			rc = do_mldsa_verify(obj, in_buf, in_size, sig_buf,
+					     sig_size);
+			break;
+		default:
+			TEE_Panic(function);
+			break;
+		}
+		break;
+	}
+#endif
+	default:
+		TEE_Panic(proc->mecha_type);
+		break;
+	}
+
+	return rc;
+}
